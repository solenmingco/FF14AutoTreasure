<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>

    <!-- Manifest fields. DalamudPackager copies these into AutoTreasure.json inside the zip. -->
    <Author>mingke</Author>
    <Name>FF14 自动挖宝助手</Name>
    <Punchline>自动买图、读图、按队列挖宝，并自动清理背包垃圾。</Punchline>
    <Description>面向国服（卫月）的 FFXIV 挖宝流程自动化助手。

当前版本实现的阶段：
  1 买图阶段   — 地图库存检查、金币余额检查
  2 读图阶段   — 读图、按背包/陆行鸟背包拆分队列
  6 丢弃垃圾   — 黑名单/白名单判定、背包满触发清理
  7 总控与设置 — 循环总开关、紧急暂停、日志与收益统计

寻路（阶段 3）、自动战斗（阶段 4）与副本（阶段 5）本版本提供接口占位，
需要在游戏内实测后逐步接入。

主命令：/at 或 /autotreasure</Description>
    <RepoUrl>https://github.com/mingke/FF14AutoTreasure</RepoUrl>
    <Tags>treasure;automation;inventory;qol</Tags>
    <CategoryTags>utility</CategoryTags>
    <LoadSync>true</LoadSync>
    <CanUnloadAsync>true</CanUnloadAsync>
  </PropertyGroup>
</Project>
